---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const speakers = [
  {
    model: 'PHA-4',
    power: '48W max',
    sensitivity: '83dB @ 1W/1m',
    dimensions: '9" x 2" x 2"',
    weight: '1 lb',
    finish: 'Black or White',
    datasheet: '/documents/line-array-speakers/pha-4-datasheet.pdf'
  },
  {
    model: 'PHA-8',
    power: '96W max',
    sensitivity: '87dB @ 1W/1m',
    dimensions: '18.5" x 2" x 2"',
    weight: '1.5 lbs',
    finish: 'Black',
    datasheet: '/documents/line-array-speakers/pha-8-datasheet.pdf'
  },
  {
    model: 'PHA-184',
    power: '48W max',
    sensitivity: '84dB @ 1W/1m',
    dimensions: '18" x 2" x 2"',
    weight: '1.5 lbs',
    finish: 'Black',
    datasheet: '/documents/line-array-speakers/pha-184-datasheet.pdf'
  },
  {
    model: 'PHA-16',
    power: '192W max',
    sensitivity: '94dB @ 1W/1m',
    dimensions: '25" x 2" x 2"',
    weight: '2.25 lbs',
    finish: 'Black, White, or Silver',
    datasheet: '/documents/line-array-speakers/pha-16-datasheet.pdf'
  },
  {
    model: 'PHA-25',
    power: '288W max',
    sensitivity: '96dB @ 1W/1m',
    dimensions: '42" x 2" x 2"',
    weight: '6 lbs',
    finish: 'Black, White, or Silver',
    datasheet: '/documents/line-array-speakers/pha-25-datasheet.pdf'
  },
  {
    model: 'PHA-264',
    power: '48W max',
    sensitivity: '84dB @ 1W/1m',
    dimensions: '26" x 2" x 2"',
    weight: '2.25 lbs',
    finish: 'Black',
    datasheet: '/documents/line-array-speakers/pha-264-datasheet.pdf'
  },
  {
    model: 'PHA-5125',
    power: '288W max',
    sensitivity: '94dB @ 1W/1m',
    dimensions: '51" x 2" x 2"',
    weight: '7.5 lbs',
    finish: 'Black, White, Silver (custom)',
    datasheet: '/documents/line-array-speakers/pha-5125-datasheet.pdf'
  },
];

const features = [
  'Defined Acoustical Coverage (DAC) for precise directional sound',
  'Ultra-compact 2" x 2" footprint fits anywhere',
  'Extruded aluminum for durability and heat dissipation',
  'Multiple finishes: black, white, or silver',
  '4-ohm impedance, 120Hz - 20kHz frequency response',
  'CE compliant with spring-loaded terminals',
];

const applications = [
  { category: 'Sports', examples: 'Arenas, tennis courts, stadiums, swimming centers, golf courses' },
  { category: 'Transportation', examples: 'Train stations, airports, light-rail, shuttles, subway stations, bus stations' },
  { category: 'Corporate', examples: 'Conference rooms, demonstrations, assemblies' },
  { category: 'Healthcare', examples: 'Hospitals, pharmacies, nursing care, doctors offices' },
  { category: 'Educational', examples: 'PA systems, assemblies, demonstrations, talent contests' },
  { category: 'Entertainment', examples: 'Live theater, home theater, casinos, amusement parks, auditoriums' },
  { category: 'Worship', examples: 'Temples, churches, mosques, synagogues' },
  { category: 'Hospitality', examples: 'Hotels, restaurants, cruise ships, theme parks, transportation' },
  { category: 'Parks & Recreation', examples: 'Yachts, RVs, jet skis, ski boats, outdoor gardens, recreation centers, sports and health clubs' },
  { category: 'Retail', examples: 'Grocery stores, whole sale, point-of-sale terminals, department stores' },
];

const breadcrumbs = [
  { name: 'Products', href: '/products' },
  { name: 'Line Array Speakers', href: '#' }
];
---

<BaseLayout title="PHA Line Array Speakers" description="Pragmatic High-Performance Array (PHA) line array speakers with Defined Acoustical Coverage. Compact 2x2 footprint speakers for commercial, professional, and residential applications.">
  <!-- Breadcrumbs -->
  <nav class="bg-gray-50 border-b border-gray-200">
    <div class="container-default py-4">
      <ol class="flex items-center space-x-2 text-sm">
        <li>
          <a href="/" class="text-gray-500 hover:text-primary">Home</a>
        </li>
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center">
            <svg class="w-4 h-4 text-gray-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {index === breadcrumbs.length - 1 ? (
              <span class="text-gray-900 font-medium">{crumb.name}</span>
            ) : (
              <a href={crumb.href} class="text-gray-500 hover:text-primary">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16">
    <div class="container-default">
      <div class="max-w-3xl">
        <span class="badge badge-primary bg-white/20 text-white mb-4">Pragmatic High-Performance Arrays</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">PHA Line Array Speakers</h1>
        <p class="text-xl text-gray-200 mb-6">
          The loudest, most efficient, and compact speakers to deliver your message.
          Defined Acoustical Coverage (DAC) technology for precise sound control.
        </p>
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <a href="/quote" class="btn-primary bg-accent hover:bg-accent-light">
            Get a Quote
          </a>
          <a href="tel:+14087481100" class="inline-flex items-center gap-2 text-white hover:text-gray-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-semibold">408-748-1100</span>
          </a>
        </div>
        <a
          href="/documents/line-array-speakers/pha-brochure.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-gray-300 hover:text-white text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Product Brochure (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="container-default">
      <div class="flex flex-wrap justify-center items-center gap-6 md:gap-12 text-sm">
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Made in USA</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>30+ Years Experience</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>CE Certified</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Direct Factory Support</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Features -->
  <section class="section-padding">
    <div class="container-default">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Defined Acoustical Coverage</h2>
          <p class="text-gray-600 mb-6">
            Introducing a new era in line-array-speaker technology. Based on years of meticulous research
            by Pragmatic engineers, the PHA Series line array columns with Defined Acoustical Coverage
            breaks new ground in performance, versatility, and cost.
          </p>
          <p class="text-gray-600 mb-6">
            Bring focused sound to any project in a sleek, unobtrusive package. With a tiny 2" x 2"
            footprint, the PHA can fit seamlessly into any display, kiosk, or entertainment venue.
          </p>
          <p class="text-gray-600">
            The PHA directional speakers ensure audio is played where you want it. Even in the noisiest
            environments, you can use a PHA focused speaker to deliver crystal clear audio to your target audience.
          </p>
        </div>
        <div class="bg-gray-100 rounded-2xl p-8 text-center">
          <div class="text-6xl font-bold text-primary mb-2">2" x 2"</div>
          <p class="text-gray-600">Actual Footprint</p>
          <p class="text-sm text-gray-500 mt-4">Compact design fits seamlessly into any installation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Choose -->
  <section class="section-padding bg-gray-50">
    <div class="container-default">
      <h2 class="text-3xl font-bold mb-4 text-center">Choose Your Model</h2>
      <p class="text-gray-600 text-center mb-8 max-w-2xl mx-auto">
        Select based on your coverage area. Longer speakers provide greater throw distance and higher output.
      </p>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto mb-12">
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-2xl font-bold text-primary mb-2">Small Spaces</div>
          <p class="text-gray-600 text-sm mb-3">Kiosks, displays, small rooms</p>
          <div class="font-semibold">PHA-4 or PHA-8</div>
          <p class="text-xs text-gray-500 mt-1">9" - 18.5" length</p>
        </div>
        <div class="bg-white rounded-xl p-6 border-2 border-primary text-center relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs px-2 py-1 rounded-full">Most Popular</span>
          <div class="text-2xl font-bold text-primary mb-2">Medium Spaces</div>
          <p class="text-gray-600 text-sm mb-3">Conference rooms, lobbies, retail</p>
          <div class="font-semibold">PHA-16 or PHA-25</div>
          <p class="text-xs text-gray-500 mt-1">25" - 42" length</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-2xl font-bold text-primary mb-2">Large Venues</div>
          <p class="text-gray-600 text-sm mb-3">Stadiums, arenas, auditoriums</p>
          <div class="font-semibold">PHA-264 or PHA-5125</div>
          <p class="text-xs text-gray-500 mt-1">26" - 51" length</p>
        </div>
      </div>

      <h3 class="text-2xl font-bold mb-6 text-center">Full Specifications</h3>
      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-xl shadow-sm border border-gray-200">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Model</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Power</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Sensitivity</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Dimensions (HxWxD)</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Weight</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Finish</th>
              <th class="px-6 py-4 text-left font-semibold text-gray-900">Datasheet</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {speakers.map((speaker) => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-semibold text-primary">{speaker.model}</td>
                <td class="px-6 py-4 text-gray-600">{speaker.power}</td>
                <td class="px-6 py-4 text-gray-600">{speaker.sensitivity}</td>
                <td class="px-6 py-4 text-gray-600">{speaker.dimensions}</td>
                <td class="px-6 py-4 text-gray-600">{speaker.weight}</td>
                <td class="px-6 py-4 text-gray-600">{speaker.finish}</td>
                <td class="px-6 py-4">
                  <a href={speaker.datasheet} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    PDF
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 mt-4 text-center">
        All models: 4-ohm impedance, 120Hz - 20kHz frequency response
      </p>

      <!-- Inline CTA -->
      <div class="mt-10 bg-primary/5 border border-primary/20 rounded-xl p-6 max-w-2xl mx-auto text-center">
        <p class="text-gray-700 mb-4">
          <strong>Not sure which model is right for your space?</strong> Our engineers can help you select the perfect speaker for your application.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/quote" class="btn-primary">
            Request a Quote
          </a>
          <a href="tel:+14087481100" class="btn-secondary flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call 408-748-1100
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why PHA is Better -->
  <section class="section-padding">
    <div class="container-default">
      <h2 class="text-3xl font-bold mb-4 text-center">Why PHA Outperforms Other Line Arrays</h2>
      <p class="text-gray-600 text-center mb-10 max-w-3xl mx-auto">
        Traditional column speakers using 3" or 4" drivers suffer from audio problems that PHA's unique 1" full-range driver design eliminates.
      </p>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-10">
        <div class="text-center">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Competitors: Combing Effect</h3>
          <p class="text-gray-600 text-sm">3" and 4" speakers create audio interference patterns in mid-frequencies, causing uneven sound.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Competitors: Sound Drop-Off</h3>
          <p class="text-gray-600 text-sm">Traditional speakers drop volume exponentially (1/d²). Listeners far away can barely hear.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">PHA: Linear Drop-Off</h3>
          <p class="text-gray-600 text-sm">Unique 1" drivers with precise array positioning deliver uniform sound to all listeners, near or far.</p>
        </div>
      </div>

      <div class="bg-primary/5 rounded-xl p-6 max-w-3xl mx-auto text-center">
        <p class="text-gray-700 mb-4">
          <strong>The result:</strong> Crystal clear audio for audiences of a few or a few thousand—without the acoustic compromises of traditional PA systems.
        </p>
        <a href="/documents/line-array-speakers/pha-pa-systems-comparison.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary hover:underline text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Technical Comparison (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- Features List -->
  <section class="section-padding bg-gray-50">
    <div class="container-default">
      <h2 class="text-3xl font-bold mb-8 text-center">Features & Benefits</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {features.map((feature) => (
          <div class="flex items-start gap-3 p-4 bg-white rounded-lg">
            <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-gray-700">{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Installed At -->
  <section class="section-padding bg-gray-50">
    <div class="container-default">
      <h2 class="text-3xl font-bold mb-4 text-center">Where PHA Speakers Are Installed</h2>
      <p class="text-gray-600 text-center mb-8 max-w-2xl mx-auto">
        Trusted by leading venues, government buildings, and hospitality brands across America.
      </p>

      <!-- Notable Installations -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto mb-12">
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-3xl mb-2">🏟️</div>
          <h3 class="font-bold text-gray-900">Ohio Stadium</h3>
          <p class="text-sm text-gray-500">Sports Venue</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-3xl mb-2">🏨</div>
          <h3 class="font-bold text-gray-900">Bellagio Hotel</h3>
          <p class="text-sm text-gray-500">Las Vegas, NV</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-3xl mb-2">🏛️</div>
          <h3 class="font-bold text-gray-900">Federal Trade Commission</h3>
          <p class="text-sm text-gray-500">Government</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-200 text-center">
          <div class="text-3xl mb-2">🏔️</div>
          <h3 class="font-bold text-gray-900">Ahwanee Lodge</h3>
          <p class="text-sm text-gray-500">Yosemite National Park</p>
        </div>
      </div>

      <!-- Use Case Highlights -->
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-12">
        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-2">Healthcare & Pharmacies</h3>
              <p class="text-gray-600 text-sm">
                Defined Acoustical Coverage meets HIPAA privacy requirements. Sound stays in waiting areas without spilling into consultation zones—often mandated by healthcare regulations.
              </p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
              </svg>
            </div>
