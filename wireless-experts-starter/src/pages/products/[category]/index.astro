---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductSearch from '../../../components/ProductSearch.astro';
import { reader, specsToRecord } from '../../../lib/keystatic';

export async function getStaticPaths() {
  const allCategories = await reader.collections.categories.all();
  const allProducts = await reader.collections.products.all();

  return allCategories.map(({ entry }) => {
    const categoryProducts = allProducts
      .filter(({ entry: p }) => p.categorySlug === entry.slug && p.available && p.showInGrid !== false)
      .map(({ slug, entry: p }) => ({
        id: slug,
        name: p.name,
        title: p.title,
        description: p.description,
        image: p.image,
        url: p.url,
        badge: p.badge ?? '',
        specs: specsToRecord(p.specs),
        keywords: p.keywords ?? [],
        downloads: p.downloads ?? [],
      }));

    return {
      params: { category: entry.slug },
      props: {
        category: entry,
        products: categoryProducts,
      },
    };
  });
}

const { category, products } = Astro.props;

const breadcrumbs = [
  { name: 'Products', href: '/products' },
  { name: category.name, href: '#' },
];
---

<BaseLayout title={category.name} description={category.description}>
  <!-- Breadcrumbs -->
  <nav class="bg-gray-50 border-b border-gray-200">
    <div class="container-default py-4">
      <ol class="flex items-center space-x-2 text-sm">
        <li>
          <a href="/" class="text-gray-500 hover:text-primary">Home</a>
        </li>
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center">
            <svg class="w-4 h-4 text-gray-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {index === breadcrumbs.length - 1 ? (
              <span class="text-gray-900 font-medium">{crumb.name}</span>
            ) : (
              <a href={crumb.href} class="text-gray-500 hover:text-primary">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16">
    <div class="container-default">
      <div class="max-w-3xl">
        {category.badge && (
          <span class="badge badge-primary bg-white/20 text-white mb-4">{category.badge}</span>
        )}
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{category.name}</h1>
        <p class="text-xl text-gray-200 mb-6">{category.description}</p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/quote" class="btn-primary bg-accent hover:bg-accent-light">
            Get a Quote
          </a>
          <a href="tel:+14087481100" class="inline-flex items-center gap-2 text-gray-300 hover:text-white text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call 408-748-1100
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section-padding">
    <div class="container-default">
      <ProductSearch />

      {products.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((product) => (
            <a
              href={product.url}
              class="card group overflow-hidden"
              data-product-card
              data-search-text={`${product.name} ${product.title} ${product.description} ${product.keywords.join(' ')} ${Object.values(product.specs).join(' ')}`}
            >
              <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-full h-full object-contain p-8 group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="card-body">
                {product.badge && (
                  <span class="badge badge-primary mb-2">{product.badge}</span>
                )}
                <h2 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
                  {product.name}
                </h2>
                <p class="text-gray-600 text-sm mb-4">{product.description}</p>
                <div class="flex flex-wrap gap-2 text-xs">
                  {Object.values(product.specs).slice(0, 3).map((spec) => (
                    <span class="bg-gray-100 px-2 py-1 rounded">{spec}</span>
                  ))}
                </div>
                {product.downloads.length > 0 && (
                  <div class="mt-3 pt-3 border-t border-gray-100">
                    <span class="text-xs text-primary font-medium">Datasheet available</span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">Products coming soon. Contact us for details.</p>
        </div>
      )}

      <!-- CTA inline -->
      <div class="mt-10 bg-primary/5 border border-primary/20 rounded-xl p-6 max-w-2xl mx-auto text-center">
        <p class="text-gray-700 mb-4">
          <strong>Need help choosing?</strong> Our engineers can help you select the right product for your application.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/quote" class="btn-primary">Request a Quote</a>
          <a href="tel:+14087481100" class="btn-secondary flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call 408-748-1100
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-secondary to-secondary-dark text-white section-padding">
    <div class="container-default text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-xl text-gray-100 mb-8 max-w-2xl mx-auto">
        Contact our team to discuss your requirements and find the right solution.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/quote" class="btn-primary bg-white text-secondary hover:bg-gray-100">
          Request a Quote
        </a>
        <a href="/contact" class="btn-outline-white">
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
