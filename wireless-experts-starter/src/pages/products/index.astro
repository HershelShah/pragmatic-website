---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductSearch from '../../components/ProductSearch.astro';
import { reader, specsToRecord } from '../../lib/keystatic';

const allProducts = await reader.collections.products.all();
const allCategories = await reader.collections.categories.all();

const availableProducts = allProducts
  .filter(({ entry }) => entry.available && entry.showInGrid !== false)
  .map(({ slug, entry }) => ({
    id: slug,
    name: entry.name,
    title: entry.title,
    category: entry.category,
    categorySlug: entry.categorySlug,
    description: entry.description,
    image: entry.image,
    url: entry.url,
    badge: entry.badge ?? '',
    specs: specsToRecord(entry.specs),
    keywords: entry.keywords ?? [],
    available: entry.available,
  }));

const categories = allCategories.map(({ entry }) => ({
  name: entry.name,
  slug: entry.slug,
  description: entry.description,
  badge: entry.badge ?? '',
}));
---

<BaseLayout title="Products" description="Professional AV solutions for digital signage, large venue displays, and commercial applications.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16">
    <div class="container-default">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Products</h1>
        <p class="text-xl text-gray-200">
          Professional AV solutions engineered for demanding commercial environments.
          Built for 24/7 operation with industry-leading reliability.
        </p>
      </div>
    </div>
  </section>

  <!-- Search & Products -->
  <section class="section-padding">
    <div class="container-default">
      <!-- Search Bar -->
      <ProductSearch />

      <!-- Product Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {availableProducts.map((product) => (
          <a
            href={product.url}
            class="card group overflow-hidden"
            data-product-card
            data-search-text={`${product.name} ${product.title} ${product.category} ${product.description} ${product.keywords.join(' ')} ${Object.values(product.specs).join(' ')}`}
          >
            <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-contain p-8 group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="card-body">
              {product.badge && (
                <span class="badge badge-primary mb-2">{product.badge}</span>
              )}
              <h2 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
                {product.name}
              </h2>
              <p class="text-gray-600 text-sm mb-4">
                {product.description}
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                {Object.values(product.specs).slice(0, 3).map(spec => (
                  <span class="bg-gray-100 px-2 py-1 rounded">{spec}</span>
                ))}
              </div>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="section-padding bg-gray-50">
    <div class="container-default">
      <h2 class="text-3xl font-bold text-center mb-8">Browse by Category</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {categories.map((category) => (
          <a
            href={`/products/${category.slug}`}
            class="bg-white rounded-lg p-6 border border-gray-200 hover:border-primary hover:shadow-md transition-all group"
          >
            <h3 class="text-lg font-semibold group-hover:text-primary transition-colors mb-2">
              {category.name}
            </h3>
            <p class="text-gray-600 text-sm">{category.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-secondary to-secondary-dark text-white section-padding">
    <div class="container-default text-center">
      <h2 class="text-3xl font-bold mb-4">Need Help Choosing?</h2>
      <p class="text-xl text-gray-100 mb-8 max-w-2xl mx-auto">
        Our team can help you select the right products for your specific application and requirements.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/quote" class="btn-primary bg-white text-secondary hover:bg-gray-100">
          Request a Quote
        </a>
        <a href="/contact" class="btn-outline-white">
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
