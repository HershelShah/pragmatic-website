---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductSearch from '../../../components/ProductSearch.astro';
import { products } from '../../../data/products';

const categoryProducts = products.filter(p => p.categorySlug === 'laser-projectors' && p.available);

const breadcrumbs = [
  { name: 'Products', href: '/products' },
  { name: 'Laser Projectors', href: '#' }
];
---

<BaseLayout title="Laser Projectors" description="Professional laser projectors for digital signage and large venue applications. 24/7 operation capable with 20,000+ hour lifespan.">
  <!-- Breadcrumbs -->
  <nav class="bg-gray-50 border-b border-gray-200">
    <div class="container-default py-4">
      <ol class="flex items-center space-x-2 text-sm">
        <li>
          <a href="/" class="text-gray-500 hover:text-primary">Home</a>
        </li>
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center">
            <svg class="w-4 h-4 text-gray-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {index === breadcrumbs.length - 1 ? (
              <span class="text-gray-900 font-medium">{crumb.name}</span>
            ) : (
              <a href={crumb.href} class="text-gray-500 hover:text-primary">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16">
    <div class="container-default">
      <div class="max-w-3xl">
        <span class="badge badge-primary bg-white/20 text-white mb-4">Pragmatic Signage</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Laser Projectors</h1>
        <p class="text-xl text-gray-200 mb-6">
          Professional-grade laser projectors designed for digital signage and large venue displays.
          Built for 24/7 continuous operation with industry-leading 20,000 hour lifespan.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/quote" class="btn-primary bg-accent hover:bg-accent-light">
            Get a Quote
          </a>
          <a href="tel:+14087481100" class="inline-flex items-center gap-2 text-gray-300 hover:text-white text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call 408-748-1100
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-white border-b border-gray-200 py-4">
    <div class="container-default">
      <div class="flex flex-wrap justify-center items-center gap-6 md:gap-12 text-sm">
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>20,000 Hour Lifespan</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>24/7 Operation</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>CE & RoHS Certified</span>
        </div>
        <div class="flex items-center gap-2 text-gray-700">
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>WUXGA Resolution</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section-padding">
    <div class="container-default">
      <!-- Search Bar -->
      <ProductSearch />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {categoryProducts.map((product) => (
          <a
            href={product.url}
            class="card group overflow-hidden"
            data-product-card
            data-search-text={`${product.name} ${product.title} ${product.category} ${product.description} ${product.keywords.join(' ')} ${Object.values(product.specs).join(' ')}`}
          >
            <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-contain p-8 group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="card-body">
              <h2 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
                {product.name}
              </h2>
              <p class="text-gray-600 text-sm mb-4">
                {product.description}
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                {Object.values(product.specs).slice(0, 3).map(spec => (
                  <span class="bg-gray-100 px-2 py-1 rounded">{spec}</span>
                ))}
              </div>
            </div>
          </a>
        ))}

      </div>

      <!-- Need Different Specs? -->
      <div class="mt-10 bg-primary/5 border border-primary/20 rounded-xl p-6 max-w-2xl mx-auto text-center">
        <p class="text-gray-700 mb-2">
          <strong>Need different brightness or features?</strong> We offer additional projector models.
        </p>
        <p class="text-gray-600 text-sm mb-4">
          Available: PLP-HD83, PLP-HD72, PLP-HD65 and more. Contact us for full catalog.
        </p>
        <a href="/quote" class="btn-primary">
          Request Full Catalog
        </a>
      </div>
    </div>
  </section>

  <!-- Digital Signage Applications -->
  <section class="section-padding bg-white">
    <div class="container-default">
      <h2 class="text-3xl font-bold text-center mb-4">Built for Digital Signage</h2>
      <p class="text-gray-600 text-center mb-10 max-w-3xl mx-auto">
        Our laser projectors are deployed across America in demanding commercial environments
        where reliability and image quality matter most.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Hospitals & Clinics</h3>
          <p class="text-gray-600 text-xs">Wayfinding & patient info</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Shopping Malls</h3>
          <p class="text-gray-600 text-xs">Retail displays & directories</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Hotels & Lobbies</h3>
          <p class="text-gray-600 text-xs">Guest info & branding</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Universities</h3>
          <p class="text-gray-600 text-xs">Campus announcements</p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mt-10">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-2">Lower Total Cost of Ownership</h3>
              <p class="text-gray-600 text-sm">
                No lamp replacements for 20,000 hours means significant savings over traditional projectors.
                Energy-efficient design with less than 0.5W standby power reduces operating costs.
              </p>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-2">High Brightness & Color Stability</h3>
              <p class="text-gray-600 text-sm">
                Professional laser light source delivers consistent brightness and color accuracy
                throughout the entire 20,000 hour lifespan—no gradual dimming like lamp projectors.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Features -->
  <section class="section-padding bg-gray-50">
    <div class="container-default">
      <h2 class="text-3xl font-bold text-center mb-4">Why Choose Pragmatic Laser Projectors?</h2>
      <p class="text-gray-600 text-center mb-12 max-w-3xl mx-auto">
        Cost-effective, energy-efficient units designed specifically for demanding digital signage applications.
      </p>
      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">20,000 Hour Lifespan</h3>
          <p class="text-gray-600">
            Professional laser light source eliminates lamp replacements. Consistent brightness and color stability for years.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">24/7 Continuous Operation</h3>
          <p class="text-gray-600">
            Designed and tested for around-the-clock digital signage. Run 24 hours x 7 days without concerns.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Flexible Installation</h3>
          <p class="text-gray-600">
            Portrait and landscape orientation (+90°, -90°). Interchangeable lens system for various throw distances.
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Energy Efficient</h3>
          <p class="text-gray-600">
            High-efficiency design with less than 0.5W standby power. Reduces operating costs vs traditional projectors.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">WUXGA Resolution</h3>
          <p class="text-gray-600">
            1920x1200 native resolution for sharp, detailed images. Supports up to 4K/30p input signals.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Multiple Control Options</h3>
          <p class="text-gray-600">
            RS-232, RJ-45 LAN, and IR control. Easily integrate with building automation and AV control systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-secondary to-secondary-dark text-white section-padding">
    <div class="container-default text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-xl text-gray-100 mb-8 max-w-2xl mx-auto">
        Contact our team to discuss your digital signage requirements and find the right projector solution.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/quote" class="btn-primary bg-white text-secondary hover:bg-gray-100">
          Request a Quote
        </a>
        <a href="/contact" class="btn-outline-white">
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
