---
import SearchModal from './SearchModal.astro';

const navigation = [
  {
    name: 'Products',
    href: '/products',
    children: [
      { name: 'Laser Projectors', href: '/products/laser-projectors' },
      { name: 'Medical Displays', href: '/products/medical-displays' },
      { name: 'Line Array Speakers', href: '/products/line-array-speakers' },
      { name: 'Amplifiers', href: '/products/amplifiers' },
      { name: 'PA Systems', href: '/products/pa-systems' },
      { name: 'Streaming Audio', href: '/products/streaming-audio' },
      { name: 'Tuners', href: '/products/tuners' },
      { name: 'Ceiling Tile Speakers', href: '/products/ceiling-tile-speakers' },
      { name: 'In-Ceiling Speakers', href: '/products/in-ceiling-speakers' },
      { name: 'Pendant Speakers', href: '/products/pendant-speakers' },
    ]
  },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'About', href: '/about' },
  { name: 'Support', href: '/support' },
];
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/logo.png"
          alt="Pragmatic Communications"
          class="h-10 w-auto"
        />
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-8">
        {navigation.map((item) => (
          item.children ? (
            <div class="relative group">
              <button class="flex items-center text-gray-700 hover:text-primary font-medium transition-colors">
                {item.name}
                <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 ease-out">
                <div class="py-2 bg-white rounded-lg shadow-xl border border-gray-100">
                  {item.children.map((child) => (
                    <a href={child.href} class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">
                      {child.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="text-gray-700 hover:text-primary font-medium transition-colors">
              {item.name}
            </a>
          )
        ))}
      </div>
      
      <!-- Phone, Search & CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="tel:+14087481100" class="flex items-center gap-2 text-gray-700 hover:text-primary font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          408-748-1100
        </a>
        <SearchModal />
        <a href="/quote" class="inline-flex items-center px-5 py-2.5 bg-accent hover:bg-accent-light text-white font-semibold rounded-lg transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
          Get a Quote
        </a>
      </div>
      
      <!-- Mobile Search & Menu -->
      <div class="flex items-center gap-2 lg:hidden">
        <SearchModal />
        <button id="mobile-menu-btn" class="p-2 text-gray-700 hover:text-primary" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4">
      {navigation.map((item) => (
        <div class="py-2">
          {item.children ? (
            <div>
              <span class="block px-3 py-2 text-gray-900 font-medium">{item.name}</span>
              <div class="pl-4">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-3 py-2 text-gray-600 hover:text-primary">
                    {child.name}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class="block px-3 py-2 text-gray-900 font-medium hover:text-primary">
              {item.name}
            </a>
          )}
        </div>
      ))}
      <div class="pt-4 px-3 space-y-3">
        <a href="tel:+14087481100" class="flex items-center justify-center gap-2 w-full px-5 py-2.5 border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call 408-748-1100
        </a>
        <a href="/quote" class="block w-full text-center px-5 py-2.5 bg-accent hover:bg-accent-light text-white font-semibold rounded-lg transition-colors">
          Get a Quote
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
