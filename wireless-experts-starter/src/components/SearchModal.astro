---
import { reader } from '../lib/keystatic';

const allProducts = await reader.collections.products.all();
const products = allProducts
  .filter(({ entry }) => entry.available)
  .map(({ slug, entry }) => ({
    name: entry.name,
    title: entry.title,
    category: entry.category,
    description: entry.description,
    image: entry.image,
    url: entry.url,
    badge: entry.badge ?? '',
    keywords: entry.keywords ?? [],
  }));
---

<!-- Search Trigger Button (for header) -->
<button
  id="search-trigger"
  class="p-2 text-gray-700 hover:text-primary transition-colors"
  aria-label="Search products"
>
  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
</button>

<!-- Search Modal -->
<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

  <!-- Modal Content -->
  <div class="relative flex items-start justify-center pt-[10vh] px-4">
    <div class="w-full max-w-2xl bg-white rounded-xl shadow-2xl overflow-hidden">
      <!-- Search Input -->
      <div class="relative border-b border-gray-200">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search products..."
          class="w-full pl-12 pr-12 py-4 text-lg focus:outline-none"
          autocomplete="off"
        />
        <button
          id="search-close"
          class="absolute right-4 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-600"
          aria-label="Close search"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="max-h-[60vh] overflow-y-auto">
        <!-- Default state: show all products -->
        <div id="search-default" class="p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Products</p>
          <div class="space-y-2">
            {products.filter(p => p.available).map(product => (
              <a
                href={product.url}
                class="flex items-center gap-4 p-3 rounded-lg hover:bg-gray-50 transition-colors search-result-item"
                data-name={product.name.toLowerCase()}
                data-title={product.title.toLowerCase()}
                data-category={product.category.toLowerCase()}
                data-description={product.description.toLowerCase()}
                data-keywords={product.keywords.join(' ').toLowerCase()}
              >
                <div class="w-16 h-16 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
                  <img src={product.image} alt={product.name} class="w-full h-full object-contain p-2" />
                </div>
                <div class="flex-grow min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 class="font-semibold text-gray-900">{product.name}</h4>
                    {product.badge && (
                      <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded">{product.badge}</span>
                    )}
                  </div>
                  <p class="text-sm text-gray-500 truncate">{product.description}</p>
                  <p class="text-xs text-gray-400 mt-1">{product.category}</p>
                </div>
                <svg class="w-5 h-5 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- No results state -->
        <div id="search-empty" class="hidden p-8 text-center">
          <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-gray-500 mb-2">No products found</p>
          <p class="text-sm text-gray-400">Try adjusting your search terms</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="border-t border-gray-200 px-4 py-3 bg-gray-50">
        <div class="flex items-center justify-between text-xs text-gray-500">
          <span>
            <kbd class="px-1.5 py-0.5 bg-white border border-gray-300 rounded text-gray-600">ESC</kbd>
            to close
          </span>
          <a href="/products" class="text-primary hover:underline">Browse all products</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchDefault = document.getElementById('search-default');
  const searchEmpty = document.getElementById('search-empty');
  const searchItems = document.querySelectorAll('.search-result-item');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchInput?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    if (searchInput) searchInput.value = '';
    document.body.style.overflow = '';
    resetSearch();
  }

  function resetSearch() {
    searchItems.forEach(item => {
      (item as HTMLElement).style.display = '';
    });
    searchDefault?.classList.remove('hidden');
    searchEmpty?.classList.add('hidden');
  }

  function performSearch(query: string) {
    const terms = query.toLowerCase().trim().split(/\s+/);

    if (!query.trim()) {
      resetSearch();
      return;
    }

    let visibleCount = 0;

    searchItems.forEach(item => {
      const el = item as HTMLElement;
      const searchableText = [
        el.dataset.name || '',
        el.dataset.title || '',
        el.dataset.category || '',
        el.dataset.description || '',
        el.dataset.keywords || ''
      ].join(' ');

      const matches = terms.every(term => searchableText.includes(term));

      if (matches) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      searchDefault?.classList.add('hidden');
      searchEmpty?.classList.remove('hidden');
    } else {
      searchDefault?.classList.remove('hidden');
      searchEmpty?.classList.add('hidden');
    }
  }

  // Event listeners
  searchTrigger?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchInput?.addEventListener('input', (e) => {
    performSearch((e.target as HTMLInputElement).value);
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Open with Cmd/Ctrl + K
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }

    // Close with Escape
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });
</script>
